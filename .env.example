# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - TP7 (Seguridad, Autenticación y Autorización JWT)
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
HOST=127.0.0.1
API_PREFIX=/api
JSON_LIMIT=100kb

# Configuración de Seguridad y JWT (Consigna 8 y 14)
JWT_SECRET=supersecretkey_uch_distributed_tp7_2026_jwt_token_sign_secure_example
JWT_EXPIRES_IN=1h
JWT_ISSUER=uch-distributed-auth
BCRYPT_ROUNDS=12

# Puertos de Microservicios Autárquicos
AUTH_SERVICE_PORT=3004
CATALOG_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003
GATEWAY_PORT=8080

# URLs de Microservicios para Gateway y Comunicación Inter-Servicios
AUTH_SERVICE_URL=http://127.0.0.1:3004
CATALOG_SERVICE_URL=http://127.0.0.1:3001
INVENTORY_SERVICE_URL=http://127.0.0.1:3002
ORDERS_SERVICE_URL=http://127.0.0.1:3003

# Conexión a Redis / Memurai (Locks Distribuidos de Exclusión Mutua)
REDIS_URL=redis://127.0.0.1:6379

# Conexiones a MongoDB (Database-per-Service)
MONGODB_URI_AUTH=mongodb://127.0.0.1:27017/db_auth
MONGODB_URI_CATALOG=mongodb://127.0.0.1:27017/db_catalog
MONGODB_URI_INVENTORY=mongodb://127.0.0.1:27017/db_inventory
MONGODB_URI_ORDERS=mongodb://127.0.0.1:27017/db_orders

# Configuración de Logging Centralizado (Winston)
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
