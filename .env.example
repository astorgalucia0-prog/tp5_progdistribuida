# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - TP4 (Consenso Distribuido Raft)
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
HOST=127.0.0.1
API_PREFIX=/api
JSON_LIMIT=100kb

# Identificador del Nodo Raft (node1 | node2 | node3 - Asignado automáticamente por npm run nodeX)
# NODE_ID=node1

# Servidor HTTP / HTTPS
HTTP_ENABLED=true
HTTPS_ENABLED=true
HTTPS_PFX_PATH=./certs/localhost.pfx
HTTPS_PFX_PASSPHRASE=tu_clave_pfx_aqui

# Conexión a Redis / Memurai (Exclusión Mutua / Lock TP2)
REDIS_URL=redis://127.0.0.1:6379

# Conexión a MongoDB (Persistencia Mongoose TP3/TP4)
MONGODB_URI=mongodb://127.0.0.1:27017/tp3_distribuida

# Configuración de Logging Centralizado (Winston)
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
