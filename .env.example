# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - TP7 (Seguridad, Autenticación y Autorización JWT)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development

# Configuración de Seguridad y JWT (Clave Criptográfica de 64 caracteres - Plantilla)
JWT_SECRET=tu_jwt_secret_criptografico_de_al_menos_64_caracteres_aqui
JWT_EXPIRES_IN=1h
JWT_ISSUER=uch-distributed-auth
BCRYPT_ROUNDS=12

# Credenciales Iniciales Externalizadas para Bootstrap / Administrador (Plantilla)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@uch.edu.ar
ADMIN_PASSWORD=TuPasswordSeguraAdmin123!
INITIAL_USER_PASSWORD=TuPasswordSeguraUsuario123!

# Puertos Host
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3004
CATALOG_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003

# Conexión a Redis
REDIS_URL=redis://127.0.0.1:6379

# Conexiones a MongoDB (Database-per-Service)
MONGODB_URI_AUTH=mongodb://127.0.0.1:27017/db_auth
MONGODB_URI_CATALOG=mongodb://127.0.0.1:27017/db_catalog
MONGODB_URI_INVENTORY=mongodb://127.0.0.1:27017/db_inventory
MONGODB_URI_ORDERS=mongodb://127.0.0.1:27017/db_orders

# Configuración de Logging
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
