# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - CATALOG SERVICE (TP5)
# ==============================================================================
# Copiar este archivo como .env dentro de services/catalog-service/ y ajustar
# los valores. El archivo .env nunca se versiona.

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
# Interfaz de red donde escucha el servicio
HOST=127.0.0.1
# Puerto HTTP del Catalog Service (asignado en el Mapa de Puertos del README raíz)
PORT=3001
# Prefijo común de todas las rutas públicas del servicio (/api/catalog/products, /api/catalog/health, ...)
API_PREFIX=/api/catalog
# Tamaño máximo aceptado para el cuerpo JSON de POST / PUT
JSON_LIMIT=100kb

# Conexión a MongoDB (Persistencia exclusiva del servicio - Database-per-Service)
# Base propia db_catalog: ningún otro microservicio debe conectarse a ella
MONGODB_URI=mongodb://127.0.0.1:27017/db_catalog

# Configuración de Logging Centralizado (Winston)
# Nivel mínimo de log que se registra (error | warn | info | http | debug)
LOG_LEVEL=info
# Tiempo de retención de los archivos de log rotados
LOG_MAX_FILES=14d
# Tamaño máximo de cada archivo de log antes de rotar
LOG_MAX_SIZE=20m
