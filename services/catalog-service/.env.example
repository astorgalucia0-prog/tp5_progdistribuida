# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - CATALOG SERVICE (TP7)
# ==============================================================================
# Copiar este archivo como .env dentro de services/catalog-service/ y ajustar
# los valores. El archivo .env nunca se versiona.

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
HOST=0.0.0.0
PORT=3001
API_PREFIX=/api/catalog
JSON_LIMIT=100kb

# Conexión a MongoDB (Persistencia exclusiva del servicio - Database-per-Service)
MONGODB_URI=mongodb://127.0.0.1:27017/db_catalog

# Configuración de Validación de Tokens JWT (Consigna 8 y 9)
JWT_SECRET=supersecretkey_uch_distributed_tp7_2026_jwt_token_sign_secure_example

# Configuración de Logging Centralizado (Winston)
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
