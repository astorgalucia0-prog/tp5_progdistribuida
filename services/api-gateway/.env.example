# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - API GATEWAY (TP7)
# ==============================================================================
# Copiar este archivo como .env dentro de services/api-gateway/ y ajustar
# los valores. El archivo .env nunca se versiona.

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
HOST=0.0.0.0
PORT=8080

# Enrutamiento hacia Microservicios Autónomos
AUTH_SERVICE_URL=http://127.0.0.1:3004
CATALOG_SERVICE_URL=http://127.0.0.1:3001
INVENTORY_SERVICE_URL=http://127.0.0.1:3002
ORDERS_SERVICE_URL=http://127.0.0.1:3003

# Configuración de Logging Centralizado (Winston)
LOG_LEVEL=info
