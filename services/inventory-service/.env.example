# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - INVENTORY SERVICE (TP7)
# ==============================================================================
# Copiar este archivo como .env dentro de services/inventory-service/ y ajustar
# los valores. El archivo .env nunca se versiona.

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
HOST=0.0.0.0
PORT=3002
API_PREFIX=/api/inventory
JSON_LIMIT=100kb

# Conexión a MongoDB (Persistencia exclusiva del servicio - Database-per-Service)
MONGODB_URI=mongodb://127.0.0.1:27017/db_inventory

# Conexión a Redis / Memurai (Locks Distribuidos de Exclusión Mutua y TTL)
REDIS_URL=redis://127.0.0.1:6379
LOCK_TTL_MS=5000
RESERVATION_TTL_SECONDS=600

# Configuración de Validación de Tokens JWT (Consigna 8 y 9)
JWT_SECRET=supersecretkey_uch_distributed_tp7_2026_jwt_token_sign_secure_example

# Configuración de Logging Centralizado (Winston)
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
