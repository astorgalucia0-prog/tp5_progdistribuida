# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - AUTH SERVICE (TP7)
# ==============================================================================
# Copiar este archivo como .env dentro de services/auth-service/ y ajustar
# los valores según corresponda. El archivo .env nunca se versiona.

# Entorno de ejecución (development | production)
NODE_ENV=development

# Configuración del Servidor HTTP / Express
HOST=0.0.0.0
PORT=3004
API_PREFIX=/api/auth
JSON_LIMIT=100kb

# Conexión a MongoDB (Persistencia exclusiva del servicio - Database-per-Service)
MONGODB_URI=mongodb://127.0.0.1:27017/db_auth

# Configuración Criptográfica y Tokens JWT (Consignas 6.1, 8.1, 8.2)
JWT_SECRET=supersecretkey_uch_distributed_tp7_2026_jwt_token_sign_secure_example
JWT_EXPIRES_IN=1h
JWT_ISSUER=uch-distributed-auth
BCRYPT_ROUNDS=12

# Configuración de Logging Centralizado (Winston)
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
